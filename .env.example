# Copy to .env. Never commit this file after inserting real values.
WORKER_TOKEN=
JOB_HMAC_KEY=
ALLOWED_CHAT_IDS=
# Stable namespace: numeric Telegram bot ID (not its secret token).
TELEGRAM_BOT_ID=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
APIFY_TOKEN=
# Classic PAT with public_repo is the supported credential mode.
GITHUB_TOKEN=
# Existing disposable public repository owned by the authenticated user.
# It must have a main branch. Preflight proves Contents + Pages write access here.
# Its description must equal: instagram-site-premium permission probe
GITHUB_PROBE_REPO=
NVIDIA_API_KEY=
DATA_DIR=./data
PORT=8787
HOST=127.0.0.1
